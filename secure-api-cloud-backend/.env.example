# Copy these into your hosting provider's secret/environment settings.
# Do not commit real secrets. Generate a long random API token and set only its SHA-256 hex digest here.
# Example digest command: node -e "console.log(require('node:crypto').createHash('sha256').update('YOUR_LONG_RANDOM_TOKEN').digest('hex'))"
API_TOKEN_SHA256=replace_with_64_character_sha256_hex_digest
PORT=8080
HOST=0.0.0.0
# JSON object mapping short service names to owner-approved HTTPS origin base URLs.
# Never accept upstream URLs from request parameters or request bodies.
UPSTREAMS_JSON={"demo":"https://example.com/"}
# Optional comma-separated browser origins if a browser frontend will call this API.
# Leave unset to disable cross-origin browser access by default.
ALLOWED_ORIGINS=
# Requests and responses are capped in code. Tune only after load/security testing.